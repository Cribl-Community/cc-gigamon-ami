# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Generated bundles, none of them tracked: the app's .tgz files (written by
# `npm run package`, or taken from a release by `npm run release:fetch`) and
# the onboarding pack's .crbl under build/packs/ (`npm run pack:build`).
# Releases are built in CI (release.yml, pack-release.yml) and attached to the
# GitHub release, which is where a release's own bundle is taken from.
build/

# Cribl pack layout for Git install (generated; committed only onto release tags by CI)
/static/
/default/

# Local dev-only Cribl credentials for the Vite Search proxy (never committed)
.dev/

# Sample source data & reference dashboard screenshots — inputs, not app source
sample_dashboards/
samples_files/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
