# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Packaged app archives — regenerable via `npm run package`.
# Ignore everything except the stable "latest" alias, which the package
# script refreshes to point at the newest build (version is inside the tgz).
build/*
!build/cc-gigamon-ami-latest.tgz

# Cribl pack layout for Git install (generated; committed only onto release tags by CI)
/static/
/default/

# Local dev-only Cribl credentials for the Vite Search proxy (never committed)
.dev/

# Sample source data & reference dashboard screenshots — inputs, not app source
sample_dashboards/
samples_files/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
